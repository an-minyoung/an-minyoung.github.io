---
layout: default
---
<div class="post home-editorial">
  <article>
    <section class="home-hero">
      <div class="home-copy">
        <h1>
          {% if site.title == 'blank' %}
            {{ site.first_name }}
            {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <p class="home-role">{{ page.subtitle }}</p>
        <p class="home-intro">{{ page.intro }}</p>

        <nav class="home-actions" aria-label="Primary profile links">
          <a href="{{ '/research/' | relative_url }}">Research <span aria-hidden="true">&rarr;</span></a>
          <a href="{{ '/cv/' | relative_url }}">CV <span aria-hidden="true">&rarr;</span></a>
          <a href="mailto:{{ site.data.socials.email }}">Email <span aria-hidden="true">&rarr;</span></a>
        </nav>
      </div>

      {% if page.profile %}
        <div class="home-profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {%
              include figure.liquid
              loading="eager"
              path=profile_image_path
              class="img-fluid z-depth-1 rounded"
              sizes="(min-width: 930px) 320px, (min-width: 576px) 36vw, 82vw"
              alt="Portrait of Minyoung An"
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="home-location">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </section>

    <section class="home-about">
      <p class="home-kicker">Research approach</p>
      <div class="home-about-copy">{{ content }}</div>
    </section>

    <section class="home-methods" aria-labelledby="methods-heading">
      <h2 id="methods-heading" class="home-kicker">Methods &amp; tools</h2>
      <p>Quantitative analysis · Computational social science · In-depth interviews</p>
      <p class="home-tools">Python · R · SQL · Stata</p>
    </section>

    {% if page.featured_talk %}
      {% include featured-talk.liquid %}
      <script defer src="{{ '/assets/js/featured-talk.js' | relative_url | bust_file_cache }}"></script>
    {% endif %}

    <section class="home-current" aria-labelledby="current-heading">
      <div>
        <p class="home-kicker">Current research</p>
        <h2 id="current-heading">People, pathways, and institutions</h2>
      </div>
      <div class="home-research-links">
        {% for theme in site.data.research %}
          <a href="{{ '/research/' | relative_url }}#{{ theme.id }}"
            ><span>{{ theme.name }}</span><span aria-hidden="true">&rarr;</span></a
          >
        {% endfor %}
        <a href="{{ '/research/' | relative_url }}#publications"
          ><span>Publications &amp; policy reports</span><span aria-hidden="true">&rarr;</span></a
        >
      </div>
    </section>

    {% if page.social %}
      <nav class="home-profile-links" aria-label="Find Minyoung online">
        <a href="https://aparc.fsi.stanford.edu/people/minyoung">Stanford profile</a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
        <a href="https://orcid.org/{{ site.data.socials.orcid_id }}">ORCID</a>
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
      </nav>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section">
        <h2><a href="{{ '/news/' | relative_url }}">News</a></h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section">
        <h2><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section">
        <h2><a href="{{ '/publications/' | relative_url }}">Selected publications</a></h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
