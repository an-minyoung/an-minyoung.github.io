---
layout: default
---
<div class="post home-editorial">
  <article>
    <section class="home-hero">
      <div class="home-copy">
        <h1>
          {% if site.title == 'blank' %}
            {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <p class="home-role">{{ page.subtitle }}</p>
        <p class="home-intro">{{ page.intro }}</p>

        <nav class="home-actions" aria-label="Primary profile links">
          <a href="{{ '/research/' | relative_url }}">Research <span aria-hidden="true">&rarr;</span></a>
          <a href="{{ '/cv/' | relative_url }}">CV <span aria-hidden="true">&rarr;</span></a>
          <a href="mailto:{{ site.data.socials.email }}">Email <span aria-hidden="true">&rarr;</span></a>
        </nav>
      </div>

      {% if page.profile %}
        <div class="home-profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {%
              include figure.liquid
              loading="eager"
              path=profile_image_path
              class="img-fluid z-depth-1 rounded"
              sizes="(min-width: 930px) 320px, (min-width: 576px) 36vw, 82vw"
              alt="Portrait of Minyoung An"
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="home-location">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </section>

    <section class="home-about">
      <p class="home-kicker">Research approach</p>
      <div class="home-about-copy">{{ content }}</div>
    </section>

    {% if page.social %}
      <div class="social home-social">
        <div class="contact-icons">{% social_links %}</div>
      </div>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section">
        <h2><a href="{{ '/news/' | relative_url }}">News</a></h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section">
        <h2><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section">
        <h2><a href="{{ '/publications/' | relative_url }}">Selected publications</a></h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
